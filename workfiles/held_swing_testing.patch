+def held_swing_time(fk, q0, q1, p_G, v_max: float, step_rad: float) -> float:
+    """The shortest duration of a joint move from q0 to q1 that keeps a point held in the hand (the held block's
+    centre) at or below v_max.  The move follows the executor's bell-shaped profile, whose path speed peaks at
+    2 / T (jenga/controller.py MotionPlayer), so T = 2 x (largest distance the point moves per unit of path) / v_max.
+
+    Inputs: fk (function: arm angles -> 4x4 gripper pose X_RG), q0, q1 (start and end arm angles), p_G (the point in
+    the gripper frame, m), v_max (m/s), step_rad (sampling step along the path, as joint_path).
+    Returns: the duration in s (0 for no motion).
+    """
+    q0, q1 = np.asarray(q0, float), np.asarray(q1, float)
+    n = max(int(np.ceil(np.max(np.abs(q1 - q0)) / step_rad)), 1)
+    s = np.linspace(0.0, 1.0, n + 1)
+    p = np.array([(fk(q0 + si * (q1 - q0)) @ np.append(p_G, 1.0))[:3] for si in s])
+    rate = np.max(np.linalg.norm(np.diff(p, axis=0), axis=1) / np.diff(s))  # m per unit of path
+    return 2.0 * rate / v_max
+
