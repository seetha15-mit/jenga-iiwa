+class TestHeldSwingTime(unittest.TestCase):
+    @staticmethod
+    def fk(q):
+        """The hand turns about z by q[0] and slides along x by q[1]."""
+        X = clearance._pose((q[1], 0.0, 0.0), q[0])
+        return X
+
+    def test_a_straight_slide_peaks_at_2_x_distance_over_T(self):
+        T = clearance.held_swing_time(self.fk, np.zeros(7), np.r_[0.0, 0.3, np.zeros(5)], np.zeros(3), 0.5, 0.01)
+        self.assertAlmostEqual(T, 2 * 0.3 / 0.5)
+
+    def test_a_turn_moves_a_point_far_from_the_axis_faster(self):
+        q1 = np.r_[np.pi / 2, np.zeros(6)]
+        near = clearance.held_swing_time(self.fk, np.zeros(7), q1, np.array([0.1, 0, 0]), 0.5, 0.01)
+        far = clearance.held_swing_time(self.fk, np.zeros(7), q1, np.array([0.4, 0, 0]), 0.5, 0.01)
+        self.assertAlmostEqual(near, 2 * 0.1 * np.pi / 2 / 0.5, places=3)  # arc length r x angle
+        self.assertAlmostEqual(far / near, 4.0, places=3)
+
