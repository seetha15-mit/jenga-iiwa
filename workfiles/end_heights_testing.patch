+    def _end_rises(self, P0, P) -> dict:
+        """How much each end of the block (centre of its end face) has risen since P0, mm.  Inner = the end nearer
+        the tower centre now."""
+        half = geo.block_dims(self.cfg)[0] / 2
+        c = np.append(self.cfg.TOWER_CENTER_XY, 0.0)
+        ends = [(P[:3, 3] + s * half * P[:3, 0], P0[:3, 3] + s * half * P0[:3, 0]) for s in (-1, 1)]
+        inner, outer = sorted(ends, key=lambda e: np.linalg.norm((e[0] - c)[:2]))
+        return dict(inner_end_up_mm=_r((inner[0][2] - inner[1][2]) * 1000),
+                    outer_end_up_mm=_r((outer[0][2] - outer[1][2]) * 1000))
+
