+    def test_end_rises_tell_the_inner_end_from_the_outer(self):
+        log = diaglog.StepLog(self.w, self.tower, 4, self.cfg)  # middle block: its centre is over the tower centre
+        X = self.w.poses[4].copy()
+        X[:3, 3] += X[:3, 0] * 0.04  # 40 mm out along its long axis: the +x end is now the outer end
+        a = np.radians(1.0)  # and tipped about its own y axis: the +x end goes down, the -x end up
+        X[:3, :3] = X[:3, :3] @ np.array([[np.cos(a), 0, np.sin(a)], [0, 1, 0], [-np.sin(a), 0, np.cos(a)]])
+        self.w.poses[4] = X
+        log.step("pull", None)
+        r, half = log.rows[0], diaglog.geo.block_dims(self.cfg)[0] / 2
+        self.assertAlmostEqual(r["outer_end_up_mm"], round(-half * np.sin(a) * 1000, 2))
+        self.assertAlmostEqual(r["inner_end_up_mm"], round(half * np.sin(a) * 1000, 2))
